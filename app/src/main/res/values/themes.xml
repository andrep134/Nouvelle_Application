<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Eebb" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/bethesda_red</item>
        <item name="colorSecondary">@color/bethesda_green</item>
        <item name="android:statusBarColor">@color/bethesda_red_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorBackground">@color/background_light</item>
        <item name="android:navigationBarColor">@color/background_light</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:textColor">@color/bethesda_red</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="materialCardViewStyle">@style/BethesdaCard</item>
        <item name="toolbarStyle">@style/BethesdaToolbar</item>
        <item name="android:navigationBarDividerColor">@color/background_light</item>
    </style>

    <style name="BethesdaCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
    </style>

    <style name="BethesdaToolbar" parent="Widget.Material3.Toolbar">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="titleCentered">true</item>
    </style>
</resources>
