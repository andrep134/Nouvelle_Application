<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Eebb" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_maroon</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_maroon_dark</item>
        <item name="colorOnPrimaryContainer">@color/white</item>
        <item name="colorSecondary">@color/brand_green</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/sand_tint</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>
        <item name="colorSurface">@color/card_veil</item>
        <item name="colorSurfaceContainer">@color/sand_background</item>
        <item name="android:statusBarColor">@color/brand_maroon_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/brand_maroon</item>
        <item name="materialButtonStyle">@style/BethesdaButton</item>
        <item name="materialCardViewStyle">@style/BethesdaCard</item>
        <item name="android:textViewStyle">@style/BethesdaText</item>
        <item name="android:colorBackground">@color/sand_background</item>
        <item name="textAppearanceHeadline6">@style/BethesdaHeadline</item>
    </style>

    <style name="BethesdaButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="BethesdaCard" parent="Widget.Material3.MaterialCardView">
        <item name="cardCornerRadius">22dp</item>
        <item name="cardElevation">6dp</item>
        <item name="cardUseCompatPadding">true</item>
    </style>

    <style name="BethesdaText" parent="@android:style/TextAppearance.Material.Body1">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="BethesdaHeadline" parent="@android:style/TextAppearance.Material.Headline">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
